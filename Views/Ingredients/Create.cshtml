@model FeedCraft.Web.Models.IngredientEditViewModel

@{
    ViewData["Title"] = "Add Ingredient";
}

<div class="container mt-4">
    <h2 class="mb-4">Add Ingredient</h2>

    <form asp-action="Create" method="post">
        <partial name="_IngredientForm" model="Model" />

        <button type="submit" class="btn btn-success">Add to Library</button>
        <a asp-action="Index" class="btn btn-link">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
