@model FeedCraft.Web.Models.ListingEditViewModel

@{
    ViewData["Title"] = "Add Listing";
}

<div class="container mt-4">
    <h2 class="mb-4">Add Listing</h2>

    <form asp-action="Create" method="post">
        <partial name="_ListingForm" model="Model" />

        <button type="submit" class="btn btn-success">Publish Listing</button>
        <a asp-action="Index" class="btn btn-link">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
