@model FeedCraft.Web.Models.ListingEditViewModel

@{
    ViewData["Title"] = "Edit Listing";
}

<div class="container mt-4">
    <h2 class="mb-4">Edit @Model.Listing.IngredientName</h2>

    <form asp-action="Edit" asp-route-id="@Model.Listing.Id" method="post">
        <partial name="_ListingForm" model="Model" />

        <button type="submit" class="btn btn-success">Save Changes</button>
        <a asp-action="Index" class="btn btn-link">Cancel</a>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
