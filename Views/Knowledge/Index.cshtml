@model List<FeedCraft.Web.Models.KnowledgeListItem>

@{
    ViewData["Title"] = "Knowledge Base";
}

<div class="container mt-4">
    <h2 class="mb-3">Knowledge Base</h2>

    <p class="text-muted">
        Published feeding specifications for common animal types and production stages. Open an
        entry to read it in full and see its nutrient target ranges. Any of these can be copied
        into the formulation form with <em>Load Template</em> on the
        <a asp-controller="Feed" asp-action="Index">formulation page</a>.
    </p>

    @if (Model.Count == 0)
    {
        <div class="alert alert-warning">No knowledge base entries have been added yet.</div>
    }
    else
    {
        <div class="list-group">
            @foreach (var entry in Model)
            {
                <a asp-action="Details" asp-route-id="@entry.Id"
                   class="list-group-item list-group-item-action py-3">
                    <div class="d-flex justify-content-between align-items-start">
                        <h5 class="mb-1">@entry.Title</h5>
                        <span class="badge bg-secondary ms-2 text-nowrap">
                            @entry.TargetCount nutrient target@(entry.TargetCount == 1 ? "" : "s")
                        </span>
                    </div>
                    <div class="mb-1">
                        <span class="badge bg-light text-dark border">@entry.AnimalType</span>
                        <span class="text-muted small">@entry.Stage</span>
                    </div>
                    <p class="mb-0 text-muted small">@entry.Excerpt</p>
                </a>
            }
        </div>
    }
</div>
