@{
    // The active-page marker. RouteData is the only thing that knows which controller rendered
    // this layout, so the nav can mark itself without every action having to set a ViewData flag.
    var currentController = ViewContext.RouteData.Values["controller"] as string;
    Func<string, bool> isActive = name => string.Equals(currentController, name, StringComparison.OrdinalIgnoreCase);
    Func<string, string> navClass = name => isActive(name) ? "nav-link active" : "nav-link";
    // Nullable, deliberately: a null attribute value makes the tag helper omit aria-current
    // entirely, which is what a non-current link should render.
    Func<string, string?> navCurrent = name => isActive(name) ? "page" : null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FeedCraft</title>
    @* Ahead of the stylesheets so the tab settles before anything else loads. Browsers that cannot
       take an SVG icon fall back to /favicon.ico on their own. *@
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FeedCraft.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        @* data-bs-theme="dark" is what flips Bootstrap's own toggler icon and collapse chrome for
           the ink band; the colours themselves come from .fc-topbar in site.css. *@
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm fc-topbar" data-bs-theme="dark">
            <div class="container-fluid">
                <a class="navbar-brand fc-brand" asp-area="" asp-controller="Home" asp-action="Index">FeedCraft</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            @* Named for what it does. The wordmark to the left is the landing
                               link; this one is the form. *@
                            <a class="@navClass("Feed")" aria-current="@navCurrent("Feed")" asp-area="" asp-controller="Feed" asp-action="Index">Formulate</a>
                        </li>
                        <li class="nav-item">
                            <a class="@navClass("Ingredients")" aria-current="@navCurrent("Ingredients")" asp-area="" asp-controller="Ingredients" asp-action="Index">Ingredient Library</a>
                        </li>
                        <li class="nav-item">
                            <a class="@navClass("Knowledge")" aria-current="@navCurrent("Knowledge")" asp-area="" asp-controller="Knowledge" asp-action="Index">Knowledge Base</a>
                        </li>
                        <li class="nav-item">
                            <a class="@navClass("Experiment")" aria-current="@navCurrent("Experiment")" asp-area="" asp-controller="Experiment" asp-action="Index">Experiment</a>
                        </li>
                        <li class="nav-item">
                            <a class="@navClass("Market")" aria-current="@navCurrent("Market")" asp-area="" asp-controller="Market" asp-action="Index">Market</a>
                        </li>
                        @* Dealers only. The link is hidden for everyone else, but the real
                           enforcement is [Authorize(Roles = ...)] on ListingsController — this
                           is presentation, not security. *@
                        @if (User.IsInRole(FeedCraftDbContext.DealerRole))
                        {
                            <li class="nav-item">
                                <a class="@navClass("Listings")" aria-current="@navCurrent("Listings")" asp-area="" asp-controller="Listings" asp-action="Index">My Listings</a>
                            </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container fc-page">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="fc-footer">
        @* The one place About is reachable from every page — it is not worth a slot in the nav band,
           which is for the six working surfaces. *@
        <div class="container fc-footer-inner">
            <span>&copy; @DateTime.Now.Year - FeedCraft</span>
            <span>Dept. of CSE, Mymensingh Engineering College</span>
            <a asp-area="" asp-controller="Home" asp-action="About">About us</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
