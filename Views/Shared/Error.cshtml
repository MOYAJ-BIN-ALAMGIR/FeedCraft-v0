@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="container mt-4">
    <h2 class="mb-3">Something went wrong</h2>

    <div class="alert alert-danger">
        FeedCraft could not complete that request. Nothing has been saved, so your ingredient
        library and saved formulations are unchanged.
    </div>

    <p class="text-muted">
        If you were in the middle of a formulation, go back to the form and press
        <em>Calculate Least-Cost Formulation</em> again. If it keeps happening, note the reference
        below &mdash; it identifies this request in the server log.
    </p>

    @if (Model.ShowRequestId)
    {
        <p>
            <strong>Reference:</strong> <code>@Model.RequestId</code>
        </p>
    }

    <a asp-controller="Feed" asp-action="Index" class="btn btn-primary">
        Back to formulation
    </a>
</div>
