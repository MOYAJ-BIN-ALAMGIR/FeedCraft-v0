@inject SignInManager<IdentityUser> SignInManager

@* Right-hand side of the navbar. The enclosing collapse div uses justify-content-between,
   so this <ul> sits opposite the main nav links. *@

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <span class="nav-link text-dark">
                @User.Identity?.Name
                @if (User.IsInRole(FeedCraftDbContext.DealerRole))
                {
                    <span class="badge bg-success ms-1">Dealer</span>
                }
            </span>
        </li>
        <li class="nav-item">
            @* A form, not a link: signing out changes state, so it goes over POST with an
               antiforgery token. *@
            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                <button type="submit" class="btn btn-link nav-link text-dark">Log out</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Account" asp-action="Register">Register</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">Log in</a>
        </li>
    }
</ul>
