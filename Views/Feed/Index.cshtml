@model FeedCraft.Domain.Models.FeedFormulationViewModel
@using FeedCraft.Web.Models

@{
    ViewData["Title"] = "Feed Formulation";
    var savedFormulations = ViewData["SavedFormulations"] as List<SavedFormulationSummary>
        ?? new List<SavedFormulationSummary>();
}

<div class="container mt-4">
    <h2 class="mb-4">Least-Cost Feed Formulation</h2>

    @if (TempData["LibraryMessage"] is string libraryMessage)
    {
        <div class="alert alert-info">@libraryMessage</div>
    }

    @if (ViewData["LoadedFormulation"] is string loadedName)
    {
        <div class="alert alert-secondary">
            Loaded saved formulation <strong>@loadedName</strong>. Editing the form below does
            not change the saved copy &mdash; save again to store a new snapshot.
        </div>
    }

    @if (Model.IsSolved)
    {
        <div class="alert alert-success">
            <h4>Optimization Result</h4>
            <p><strong>Total Cost:</strong> $@Model.TotalCost.ToString("F2")</p>

            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>Ingredient</th>
                        <th>Quantity (kg)</th>
                        <th>% of Batch</th>
                        <th>Limit (Min&ndash;Max %)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ingredient in Model.Ingredients)
                    {
                        var qty = Model.OptimizedQuantities.TryGetValue(ingredient.Id, out var q) ? q : 0.0;
                        var minLbl = (ingredient.MinInclusionPct ?? 0).ToString("0.##");
                        var maxLbl = (ingredient.MaxInclusionPct ?? 100).ToString("0.##");
                        <tr>
                            <td>@ingredient.Name</td>
                            <td>@qty.ToString("F2")</td>
                            <td>@((qty / Model.BatchSize * 100).ToString("F2"))%</td>
                            <td>@minLbl &ndash; @maxLbl</td>
                        </tr>
                    }
                </tbody>
            </table>

            <h5 class="mt-4">Nutrient Analysis</h5>
            <table class="table table-bordered table-sm">
                <thead>
                    <tr>
                        <th>Nutrient</th>
                        <th>Value</th>
                        <th>Target (Min - Max)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var nutrient in Model.NutrientDefinitions)
                    {
                        var value = Model.CalculatedNutrients.TryGetValue(nutrient.Id, out var v) ? v : 0.0;
                        var constraint = Model.FindConstraint(nutrient.Id);
                        var min = constraint?.MinValue?.ToString("F2") ?? "-";
                        var max = constraint?.MaxValue?.ToString("F2") ?? "-";

                        <tr>
                            <td>@nutrient.Name <span class="text-muted">(@nutrient.Unit)</span></td>
                            <td>@value.ToString("F2")</td>
                            <td>@min - @max</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">
            <h4>Error</h4>
            <p>@Model.ErrorMessage</p>
        </div>
    }

    @* A sibling of #feedForm, never nested inside it — nested forms are invalid HTML and
       the inner one is silently dropped by the browser. *@
    <form asp-action="Load" method="get" class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">Saved Formulations</h5>
        </div>
        <div class="card-body">
            @if (savedFormulations.Count == 0)
            {
                <p class="text-muted mb-0">
                    Nothing saved yet. Fill in the form below, give it a name and press
                    <em>Save Formulation</em>.
                </p>
            }
            else
            {
                <div class="row g-2 align-items-center">
                    <div class="col-sm-6">
                        <select name="id" class="form-select" aria-label="Saved formulation">
                            @foreach (var item in savedFormulations)
                            {
                                <option value="@item.Id">@item.Name &mdash; @item.CreatedAt.ToString("g")</option>
                            }
                        </select>
                    </div>
                    <div class="col-sm-3">
                        <button type="submit" class="btn btn-outline-secondary">Load Formulation</button>
                    </div>
                </div>
            }
        </div>
    </form>

    <form asp-action="Calculate" method="post" id="feedForm">

        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="card mb-4">
            <div class="card-header">
                <h5>Batch Settings</h5>
            </div>
            <div class="card-body">
                <div class="form-group row">
                    <label class="col-sm-2 col-form-label">Batch Size (kg):</label>
                    <div class="col-sm-4">
                        <input asp-for="BatchSize" class="form-control" />
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5>Ingredients</h5>
                <div>
                    <button type="button" class="btn btn-primary btn-sm" onclick="addIngredientRow()">Add Ingredient</button>
                    <button type="button" class="btn btn-outline-primary btn-sm" onclick="addNutrient()">Add Nutrient</button>
                </div>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-sm" id="ingredientsTable">
                        <thead>
                            <tr id="ingredientsHeaderRow">
                                <th>Name</th>
                                <th>Cost/Unit</th>
                                @foreach (var nutrient in Model.NutrientDefinitions)
                                {
                                    <th class="nutrient-col">@nutrient.Name (@nutrient.Unit)</th>
                                }
                                <th id="thMinPct">Min %</th>
                                <th id="thMaxPct">Max %</th>
                                <th id="thActions"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Ingredients.Count; i++)
                            {
                                <tr>
                                    <td>
                                        <input type="hidden" asp-for="Ingredients[i].Id" />
                                        <input asp-for="Ingredients[i].Name" class="form-control" />
                                    </td>
                                    <td><input asp-for="Ingredients[i].CostPerUnit" class="form-control" step="0.01" /></td>

                                    @* One column per nutrient definition — nothing here is hardcoded. *@
                                    @for (int k = 0; k < Model.Ingredients[i].NutrientValues.Count; k++)
                                    {
                                        <td class="nutrient-cell">
                                            <input type="hidden" asp-for="Ingredients[i].NutrientValues[k].NutrientDefinitionId" />
                                            <input asp-for="Ingredients[i].NutrientValues[k].Value" class="form-control" step="0.01" />
                                        </td>
                                    }

                                    <td class="incl-min-cell"><input asp-for="Ingredients[i].MinInclusionPct" class="form-control" step="0.1" placeholder="0" /></td>
                                    <td class="incl-max-cell"><input asp-for="Ingredients[i].MaxInclusionPct" class="form-control" step="0.1" placeholder="100" /></td>
                                    <td><button type="button" class="btn btn-danger btn-sm" onclick="removeRow(this)">X</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h5>Nutrients &amp; Constraints</h5>
            </div>
            <div class="card-body">
                <p class="text-muted small mb-2">
                    Leave Min and Max blank to track a nutrient without constraining it.
                    Min/Max are read in the same unit as the ingredient values, so both
                    <em>%</em> and absolute units such as <em>kcal/kg</em> work as-is.
                </p>
                <div class="table-responsive">
                    <table class="table table-sm" id="nutrientsTable">
                        <thead>
                            <tr>
                                <th>Nutrient</th>
                                <th>Unit</th>
                                <th class="text-center">Is %</th>
                                <th>Min Value</th>
                                <th>Max Value</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int k = 0; k < Model.NutrientDefinitions.Count; k++)
                            {
                                <tr>
                                    <td>
                                        <input type="hidden" asp-for="NutrientDefinitions[k].Id" />
                                        <input asp-for="NutrientDefinitions[k].Name" class="form-control" oninput="syncNutrientHeaders()" />
                                    </td>
                                    <td><input asp-for="NutrientDefinitions[k].Unit" class="form-control" oninput="syncNutrientHeaders()" /></td>
                                    <td class="text-center align-middle">
                                        @* Rendered explicitly rather than with asp-for: the tag helper emits the
                                           hidden "false" companion at the end of the <form>, where the JS
                                           re-indexer can't reach it — a removed row would leave a phantom
                                           NutrientDefinitions[n] behind and bind an empty nutrient. *@
                                        <input type="checkbox" class="form-check-input"
                                               name="NutrientDefinitions[@k].IsPercentage" value="true"
                                               checked="@Model.NutrientDefinitions[k].IsPercentage" />
                                        <input type="hidden" name="NutrientDefinitions[@k].IsPercentage" value="false" />
                                    </td>
                                    <td>
                                        <input type="hidden" asp-for="Constraints[k].NutrientDefinitionId" />
                                        <input asp-for="Constraints[k].MinValue" class="form-control" step="0.01" />
                                    </td>
                                    <td><input asp-for="Constraints[k].MaxValue" class="form-control" step="0.01" /></td>
                                    <td><button type="button" class="btn btn-danger btn-sm" onclick="removeNutrient(this)">X</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h5>Save This Formulation</h5>
            </div>
            <div class="card-body">
                <div class="row g-2 align-items-center">
                    <div class="col-sm-6">
                        <input asp-for="SaveName" class="form-control" placeholder="e.g. Broiler starter, Aug 2026" />
                        <span asp-validation-for="SaveName" class="text-danger"></span>
                    </div>
                    <div class="col-sm-4">
                        @* formaction/formmethod retarget this one button at Save, so the live
                           form state and its antiforgery token are reused as-is. *@
                        <button type="submit" class="btn btn-outline-success"
                                formaction="@Url.Action("Save")" formmethod="post">
                            Save Formulation
                        </button>
                    </div>
                </div>
                <p class="text-muted small mb-0 mt-2">
                    Saves the inputs above together with the results they produce, as a snapshot.
                    Later edits to the ingredient library will not change it.
                </p>
            </div>
        </div>

        <button type="submit" class="btn btn-success btn-lg">Calculate Least Cost Mix</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function hidden(name, value) {
            return '<input type="hidden" name="' + name + '" value="' + value + '" />';
        }

        function ingredientBody() {
            return document.getElementById("ingredientsTable").getElementsByTagName('tbody')[0];
        }

        function nutrientBody() {
            return document.getElementById("nutrientsTable").getElementsByTagName('tbody')[0];
        }

        // Ids must be unique across the posted form; new rows take max+1.
        function nextId(selector) {
            var max = 0;
            document.querySelectorAll(selector).forEach(function (el) {
                var n = parseInt(el.value, 10);
                if (!isNaN(n) && n > max) max = n;
            });
            return max + 1;
        }

        function addIngredientRow() {
            var body = ingredientBody();
            var index = body.rows.length;
            var row = body.insertRow(index);
            var newId = nextId('input[name$=".Id"][name^="Ingredients["]');

            var html =
                '<td>' + hidden('Ingredients[' + index + '].Id', newId) +
                    '<input name="Ingredients[' + index + '].Name" class="form-control" value="New Ingredient" /></td>' +
                '<td><input name="Ingredients[' + index + '].CostPerUnit" class="form-control" type="number" step="0.01" value="0" /></td>';

            // A value cell per existing nutrient, in the same order as the headers.
            var nutrientRows = nutrientBody().rows;
            for (var k = 0; k < nutrientRows.length; k++) {
                var nutrientId = nutrientRows[k].querySelector('input[name^="NutrientDefinitions["][name$=".Id"]').value;
                html += '<td class="nutrient-cell">' +
                    hidden('Ingredients[' + index + '].NutrientValues[' + k + '].NutrientDefinitionId', nutrientId) +
                    '<input name="Ingredients[' + index + '].NutrientValues[' + k + '].Value" class="form-control" type="number" step="0.01" value="0" /></td>';
            }

            html +=
                '<td class="incl-min-cell"><input name="Ingredients[' + index + '].MinInclusionPct" class="form-control" type="number" step="0.1" placeholder="0" /></td>' +
                '<td class="incl-max-cell"><input name="Ingredients[' + index + '].MaxInclusionPct" class="form-control" type="number" step="0.1" placeholder="100" value="100" /></td>' +
                '<td><button type="button" class="btn btn-danger btn-sm" onclick="removeRow(this)">X</button></td>';

            row.innerHTML = html;
        }

        // Adds a nutrient: one row in the constraints table, and one column
        // across every ingredient row.
        function addNutrient() {
            var body = nutrientBody();
            var k = body.rows.length;
            var newId = nextId('input[name^="NutrientDefinitions["][name$=".Id"]');
            var row = body.insertRow(k);

            row.innerHTML =
                '<td>' + hidden('NutrientDefinitions[' + k + '].Id', newId) +
                    '<input name="NutrientDefinitions[' + k + '].Name" class="form-control" value="New Nutrient" oninput="syncNutrientHeaders()" /></td>' +
                '<td><input name="NutrientDefinitions[' + k + '].Unit" class="form-control" value="%" oninput="syncNutrientHeaders()" /></td>' +
                '<td class="text-center align-middle">' +
                    '<input type="checkbox" name="NutrientDefinitions[' + k + '].IsPercentage" value="true" checked class="form-check-input" />' +
                    hidden('NutrientDefinitions[' + k + '].IsPercentage', 'false') + '</td>' +
                '<td>' + hidden('Constraints[' + k + '].NutrientDefinitionId', newId) +
                    '<input name="Constraints[' + k + '].MinValue" class="form-control" type="number" step="0.01" /></td>' +
                '<td><input name="Constraints[' + k + '].MaxValue" class="form-control" type="number" step="0.01" /></td>' +
                '<td><button type="button" class="btn btn-danger btn-sm" onclick="removeNutrient(this)">X</button></td>';

            // New header column, inserted before the inclusion-limit headers.
            var th = document.createElement('th');
            th.className = 'nutrient-col';
            var thMin = document.getElementById('thMinPct');
            thMin.parentNode.insertBefore(th, thMin);

            // New value cell on every ingredient row.
            var rows = ingredientBody().rows;
            for (var i = 0; i < rows.length; i++) {
                var cellIndex = rows[i].querySelectorAll('td.nutrient-cell').length;
                var td = document.createElement('td');
                td.className = 'nutrient-cell';
                td.innerHTML =
                    hidden('Ingredients[' + i + '].NutrientValues[' + cellIndex + '].NutrientDefinitionId', newId) +
                    '<input name="Ingredients[' + i + '].NutrientValues[' + cellIndex + '].Value" class="form-control" type="number" step="0.01" value="0" />';
                rows[i].insertBefore(td, rows[i].querySelector('td.incl-min-cell'));
            }

            syncNutrientHeaders();
        }

        function removeNutrient(btn) {
            var row = btn.closest('tr');
            var k = row.rowIndex - 1; // rowIndex counts the header row
            row.parentNode.removeChild(row);

            // Drop the matching header and the matching cell on every ingredient row.
            var headers = document.querySelectorAll('#ingredientsHeaderRow th.nutrient-col');
            if (headers[k]) headers[k].parentNode.removeChild(headers[k]);

            var rows = ingredientBody().rows;
            for (var i = 0; i < rows.length; i++) {
                var cells = rows[i].querySelectorAll('td.nutrient-cell');
                if (cells[k]) rows[i].removeChild(cells[k]);
            }

            reIndexNutrients();
            reIndexRows();
            syncNutrientHeaders();
        }

        function removeRow(btn) {
            var row = btn.closest('tr');
            row.parentNode.removeChild(row);
            // Re-index so model binding still sees a contiguous list after a delete.
            reIndexRows();
        }

        // Rewrites Ingredients[i] on every input, including the nested
        // NutrientValues[k] indices, which are keyed off cell position.
        function reIndexRows() {
            var rows = ingredientBody().rows;
            for (var i = 0; i < rows.length; i++) {
                rows[i].querySelectorAll('input').forEach(function (input) {
                    if (input.name.indexOf('Ingredients[') === 0) {
                        input.name = input.name.replace(/^Ingredients\[\d+\]/, 'Ingredients[' + i + ']');
                    }
                });

                rows[i].querySelectorAll('td.nutrient-cell').forEach(function (cell, k) {
                    cell.querySelectorAll('input').forEach(function (input) {
                        input.name = input.name.replace(/NutrientValues\[\d+\]/, 'NutrientValues[' + k + ']');
                    });
                });
            }
        }

        function reIndexNutrients() {
            var rows = nutrientBody().rows;
            for (var k = 0; k < rows.length; k++) {
                rows[k].querySelectorAll('input').forEach(function (input) {
                    input.name = input.name
                        .replace(/^NutrientDefinitions\[\d+\]/, 'NutrientDefinitions[' + k + ']')
                        .replace(/^Constraints\[\d+\]/, 'Constraints[' + k + ']');
                });
            }
        }

        // Keeps the ingredient-table column headers in step with the nutrient names/units.
        function syncNutrientHeaders() {
            var headers = document.querySelectorAll('#ingredientsHeaderRow th.nutrient-col');
            var rows = nutrientBody().rows;
            for (var k = 0; k < headers.length && k < rows.length; k++) {
                var name = rows[k].querySelector('input[name$=".Name"]');
                var unit = rows[k].querySelector('input[name$=".Unit"]');
                headers[k].textContent = (name ? name.value : '') + (unit && unit.value ? ' (' + unit.value + ')' : '');
            }
        }
    </script>
}
