@model FeedCraft.Domain.Models.FeedFormulationViewModel

@{
    ViewData["Title"] = "Feed Formulation";
    var savedFormulations = ViewData["SavedFormulations"] as List<SavedFormulationSummary>
        ?? new List<SavedFormulationSummary>();
    var knowledgeTemplates = ViewData["KnowledgeTemplates"] as List<KnowledgeTemplateSummary>
        ?? new List<KnowledgeTemplateSummary>();
}

<div class="container mt-4">
    <h2 class="mb-4">Least-Cost Feed Formulation</h2>

    @if (TempData["LibraryMessage"] is string libraryMessage)
    {
        <div class="alert alert-info">@libraryMessage</div>
    }

    @if (ViewData["LoadedFormulation"] is string loadedName)
    {
        <div class="alert alert-secondary">
            Loaded saved formulation <strong>@loadedName</strong>. Editing the form below does
            not change the saved copy &mdash; save again to store a new snapshot.
        </div>
    }

    @if (ViewData["LoadedTemplate"] is string loadedTemplate)
    {
        <div class="alert alert-secondary">@loadedTemplate</div>
    }

    @* Shared with /Experiment, which renders the same block once per panel. Rendered with
       model="Model" so the field prefix stays empty and every posted name is unchanged. *@
    <partial name="_FormulationResults" model="Model" />

    @* A sibling of #feedForm, never nested inside it — nested forms are invalid HTML and
       the inner one is silently dropped by the browser. *@
    <form asp-action="Load" method="get" class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">Saved Formulations</h5>
        </div>
        <div class="card-body">
            @if (savedFormulations.Count == 0)
            {
                <p class="text-muted mb-0">
                    Nothing saved yet. Fill in the form below, give it a name and press
                    <em>Save Formulation</em>.
                </p>
            }
            else
            {
                <div class="row g-2 align-items-center">
                    <div class="col-sm-6">
                        <select name="id" class="form-select" aria-label="Saved formulation">
                            @foreach (var item in savedFormulations)
                            {
                                <option value="@item.Id">@item.Name &mdash; @item.CreatedAt.ToString("g")</option>
                            }
                        </select>
                    </div>
                    <div class="col-sm-3">
                        <button type="submit" class="btn btn-outline-secondary">Load Formulation</button>
                    </div>
                </div>
            }
        </div>
    </form>

    <form asp-action="Calculate" method="post" id="feedForm">

        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        @* This select and its button sit *inside* #feedForm, unlike the Saved
           Formulations picker above which is a sibling GET form. That is deliberate:
           loading a template must preserve the ingredient rows, costs and batch size
           already on screen and change only the constraint fields, which means the
           live form state has to be posted. formaction/formmethod retarget this one
           button at LoadTemplate, reusing that state and its antiforgery token —
           the same trick the Save button uses further down.

           Consequence: templateId also rides along on Calculate and Save. Neither
           action binds it, so it is harmlessly ignored there. Do not "fix" this by
           nesting a second form — the browser silently drops inner forms.

           It used to sit at the top of the Nutrients & Constraints card; it moved out when
           that card became a shared partial, since the picker is specific to this page. Only
           its position in the posted body changed, and nothing binds by position. *@
        @if (knowledgeTemplates.Count > 0)
        {
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Load From Knowledge Base</h5>
                </div>
                <div class="card-body">
                    <div class="row g-2 align-items-center">
                        <div class="col-sm-6">
                            <select name="templateId" class="form-select" aria-label="Knowledge base template">
                                @foreach (var template in knowledgeTemplates)
                                {
                                    <option value="@template.Id">@template.Title</option>
                                }
                            </select>
                        </div>
                        <div class="col-sm-6">
                            <button type="submit" class="btn btn-outline-primary"
                                    formaction="@Url.Action("LoadTemplate")" formmethod="post">
                                Load Template
                            </button>
                            <a asp-controller="Knowledge" asp-action="Index" class="btn btn-link">
                                Browse knowledge base
                            </a>
                        </div>
                    </div>
                    <p class="text-muted small mb-0 mt-2">
                        Replaces the Min and Max values below with that entry's published
                        targets. Ingredients, costs and batch size are left alone, and any
                        nutrient the template does not mention is left unconstrained.
                    </p>
                </div>
            </div>
        }

        @* Batch size, the ingredient grid and the nutrient constraints. Same partial the two
           /Experiment panels use; model="Model" keeps the field prefix empty here. *@
        <partial name="_FormulationInputs" model="Model" />

        <div class="card mb-4">
            <div class="card-header">
                <h5>Save This Formulation</h5>
            </div>
            <div class="card-body">
                <div class="row g-2 align-items-center">
                    <div class="col-sm-6">
                        <input asp-for="SaveName" class="form-control" placeholder="e.g. Broiler starter, Aug 2026" />
                        <span asp-validation-for="SaveName" class="text-danger"></span>
                    </div>
                    <div class="col-sm-4">
                        @* formaction/formmethod retarget this one button at Save, so the live
                           form state and its antiforgery token are reused as-is. *@
                        <button type="submit" class="btn btn-outline-success"
                                formaction="@Url.Action("Save")" formmethod="post">
                            Save Formulation
                        </button>
                    </div>
                </div>
                <p class="text-muted small mb-0 mt-2">
                    Saves the inputs above together with the results they produce, as a snapshot.
                    Later edits to the ingredient library will not change it.
                </p>
            </div>
        </div>

        <button type="submit" class="btn btn-success btn-lg">Calculate Least Cost Mix</button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @* Add/remove row behaviour for _FormulationInputs. Loaded per page rather than from
       site.js, which _Layout loads everywhere — /Market and /Knowledge have no such form. *@
    <script src="~/js/formulation-panel.js" asp-append-version="true"></script>
}
